{
  "uid": "inferrail-overview",
  "title": "Inferrail",
  "description": "TTFT, load, routing and KV index predictions per replica.",
  "tags": [
    "inferrail"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
